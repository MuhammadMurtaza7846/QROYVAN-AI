      {page === 'Memory' && <section className="content-view"><div className="section-heading"><div><span className="eyebrow">YOUR PERSONAL KNOWLEDGE HUB</span><h2>Knowledge & Memory</h2><p>Upload documents and ask QROYVAN questions about their contents.</p></div><button className="primary-button" onClick={() => fileRef.current?.click()}><Plus size={17}/> Add knowledge</button></div><div className="memory-stats"><div><FileText/><b>{docs.length}</b><span>Documents</span></div><div><BrainCircuit/><b>{docs.reduce((n,d) => n+d.chunks,0)}</b><span>Indexed chunks</span></div><div><ShieldCheck/><b>RAG</b><span>Retrieval enabled</span></div></div><div className="upload-drop" onDragOver={e => e.preventDefault()} onDrop={e => { e.preventDefault(); void uploadFile(e.dataTransfer.files[0]); }}><div className="upload-icon"><Upload size={23}/></div><b>{uploading ? 'Indexing your documentÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¦' : 'Bring your knowledge to QROYVAN'}</b><p>Drag and drop PDF, DOCX, TXT, MD, CSV or JSON files here</p><button className="outline-button" onClick={() => fileRef.current?.click()} disabled={uploading}>{uploading ? <LoaderCircle className="spin" size={16}/> : <Plus size={16}/>} Choose file</button><small>Maximum file size: 20 MB. Text is extracted and indexed for semantic search.</small></div><div className="list-heading"><h3>Your knowledge sources</h3><span>{filteredDocs.length} items</span></div><div className="document-list">{filteredDocs.length ? filteredDocs.map(d => <div className="document-row" key={d.id}><span className="doc-icon"><FileText size={20}/></span><div className="doc-meta"><b>{d.filename}</b><small>{d.chunks} indexed chunks ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â· {d.created_at ? new Date(d.created_at).toLocaleDateString() : 'Recently added'}</small></div><span className="indexed"><span/> Indexed</span><button className="icon-button delete-button" title={`Delete ${d.filename}`} onClick={() => void removeDoc(d.id)}><Trash2 size={16}/></button></div>) : <div className="empty-state"><BookOpen size={28}/><b>No knowledge sources yet</b><p>Upload a document to start asking questions with citations.</p></div>}</div></section>}

      {page === 'Tasks' && <section className="content-view"><div className="section-heading"><div><span className="eyebrow">YOUR WORKSPACE</span><h2>Tasks & Actions</h2><p>Keep your AI workflow organized.</p></div><button className="primary-button" onClick={() => setNotice('Task creation is a planned extension. Chat, RAG, uploads and voice are available in this starter.')}><Plus size={17}/> New task</button></div><div className="feature-grid"><div className="feature-card"><Zap/><h3>Ask your documents</h3><p>Retrieve facts and answers from indexed files.</p><button onClick={() => setPage('Memory')}>Open knowledge <ArrowRight size={14}/></button></div><div className="feature-card"><MessageCircle/><h3>Start a conversation</h3><p>Ask questions with cited source passages.</p><button onClick={() => setPage('Chat')}>Open chat <ArrowRight size={14}/></button></div><div className="feature-card"><Mic/><h3>Voice assistant</h3><p>Talk naturally and interrupt the assistant.</p><button onClick={() => void startVoice()}>Start speaking <ArrowRight size={14}/></button></div></div></section>}

      {page === 'Apps & Tools' && <section className="content-view"><div className="section-heading"><div><span className="eyebrow">YOUR AI TOOLKIT</span><h2>Apps & Tools</h2><p>Useful capabilities, unified in one workspace.</p></div></div><div className="tool-grid">{[{icon:Search,name:'Knowledge Search',desc:'Find relevant passages across your files',action:()=>setPage('Memory')},{icon:MessageCircle,name:'AI Chat',desc:'Ask grounded questions and follow up',action:()=>setPage('Chat')},{icon:AudioLines,name:'Live Voice',desc:'Real-time speech-to-speech assistant',action:()=>void startVoice()},{icon:CloudUpload,name:'Document Ingestion',desc:'Upload and index your knowledge base',action:()=>fileRef.current?.click()},{icon:Globe,name:'Web Search',desc:'External web search can be added as a tool',action:()=>setNotice('Web search is not enabled in this starter; connect an approved search provider to add it.')},{icon:Settings,name:'Preferences',desc:'Review configuration and status',action:()=>setPage('Settings')}].map(({icon:Icon,name,desc,action})=><button className="tool-card" key={name} onClick={action}><span><Icon size={22}/></span><b>{name}</b><p>{desc}</p><ArrowRight size={16}/></button>)}</div></section>}

      {page === 'Settings' && <section className="content-view"><div className="section-heading"><div><span className="eyebrow">PREFERENCES</span><h2>Settings</h2><p>Personalize your QROYVAN workspace.</p></div></div><div className="settings-card"><div className="settings-title"><span className="avatar large">Q</span><div><b>Appearance</b><p>Theme and background preferences</p></div><span className="pill">Saved locally</span></div><div className="appearance-block"><b>Choose a theme</b><p>Changes apply immediately.</p><div className="theme-options"><button type="button" className={qroyvanTheme === 'dark' ? 'theme-choice selected' : 'theme-choice'} onClick={() => changeQroyvanTheme('dark')}>Dark</button><button type="button" className={qroyvanTheme === 'light' ? 'theme-choice selected' : 'theme-choice'} onClick={() => changeQroyvanTheme('light')}>Light</button><button type="button" className={qroyvanTheme === 'blue' ? 'theme-choice selected' : 'theme-choice'} onClick={() => changeQroyvanTheme('blue')}>Blue</button><button type="button" className={qroyvanTheme === 'purple' ? 'theme-choice selected' : 'theme-choice'} onClick={() => changeQroyvanTheme('purple')}>Purple</button></div></div><div className="appearance-block"><b>Background gallery</b><p>Choose a background for your workspace.</p><div className="background-options"><button type="button" className="background-choice bg-mountain" onClick={() => changeQroyvanBackground('https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1800&q=80')}>Mountain</button><button type="button" className="background-choice bg-ocean" onClick={() => changeQroyvanBackground('https://images.unsplash.com/photo-1518837695005-2083093ee35b?auto=format&fit=crop&w=1800&q=80')}>Ocean</button><button type="button" className="background-choice bg-forest" onClick={() => changeQroyvanBackground('https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=1800&q=80')}>Forest</button><button type="button" className="background-choice bg-default" onClick={() => changeQroyvanBackground('')}>Default</button></div><button type="button" className="outline-button" onClick={() => backgroundFileRef.current?.click()}><Upload size={16}/> Upload your image</button><input ref={backgroundFileRef} type="file" accept="image/*" hidden onChange={e => uploadQroyvanBackground(e.target.files?.[0])}/><small>Image files only; maximum 5 MB. Your custom image is stored in this browser.</small></div><div className="settings-row"><div><b>Backend API</b><small>{API}</small></div><span className="indexed"><span/> Configured URL</span></div><div className="settings-row"><div><b>Knowledge retrieval</b><small>Embeddings + PostgreSQL pgvector</small></div><span className="pill">RAG</span></div><div className="settings-row"><div><b>Voice connection</b><small>WebRTC Realtime API ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â· browser microphone</small></div><span className="pill">{voiceState === 'idle' ? 'Disconnected' : voiceState}</span></div><div className="settings-note"><ShieldCheck size={18}/><p>Keep API keys on the backend. Before deploying publicly, add authentication, per-user data isolation, rate limits and HTTPS.</p></div><button type="button" className="outline-button reset-appearance" onClick={resetQroyvanAppearance}>Reset appearance</button></div></section>}

      <footer className="footer"><span>QROYVAN <i>AI</i></span><span><span className="online-dot"/> Knowledge in conversation</span><span>Built for your ideas <Sparkles size={12}/></span></footer>
    </section>
    <aside className="right-rail">
<div className="rail-card glass-panel">
  <div className="rail-heading">
    <div><Activity size={17}/><h3>Time</h3></div>
  </div>
  <div className="activity-item">
    <span className="activity-icon"><Activity size={19}/></span>
    <div><b>Current time</b><LiveClock /></div>
  </div>
</div>
<div className="rail-card glass-panel">
  <div className="rail-heading">
    <div><FileText size={17}/><h3>Files</h3></div>
    <button onClick={() => setPage('Memory')}>Open <ArrowRight size={13}/></button>
  </div>
  <div className="activity-item">
    <span className="activity-icon"><FileText size={19}/></span>
    <div>
      <b>{docs.length} uploaded document(s)</b>
      <p>{docs.reduce((n, d) => n + d.chunks, 0)} indexed chunks</p>
    </div>
  </div>
</div>
<div className="rail-card glass-panel">
  <div className="rail-heading">
    <div><AudioLines size={17}/><h3>Voice Assistant</h3></div>
    <button onClick={() => setPage('Settings')}>Settings <ArrowRight size={13}/></button>
  </div>
  <div className="activity-item">
    <span className="activity-icon"><AudioLines size={19}/></span>
    <div>
      <b>{voiceState === 'idle' ? 'Ready to talk' : orbLabel}</b>
      <p>Active App: {page}</p>
      <small>{voiceState === 'listening' ? 'Listening to you' : voiceState === 'speaking' ? 'Assistant is speaking' : voiceState === 'connecting' ? 'Connecting...' : voiceState === 'error' ? 'Connection error' : 'Voice not connected'}</small>
    </div>
  </div>
  <button className="rail-upload" onClick={() => voiceState === 'idle' || voiceState === 'error' ? void startVoice() : void stopVoice()}>
    <AudioLines size={15}/> {voiceState === 'idle' || voiceState === 'error' ? 'Start voice assistant' : 'Stop voice assistant'}
  </button>
</div>
<div className="rail-card glass-panel sources-rail"><div className="rail-heading"><div><BookOpen size={17}/><h3>Knowledge sources</h3></div><button onClick={() => setPage('Memory')}>Manage <ArrowRight size={13}/></button></div><div className="source-summary"><div><FileText/><b>{docs.length}</b><small>Documents</small></div><div><BrainCircuit/><b>{docs.reduce((n,d)=>n+d.chunks,0)}</b><small>Chunks</small></div><div><ShieldCheck/><b>Live</b><small>Retrieval</small></div></div><button className="rail-upload" onClick={() => fileRef.current?.click()}><Plus size={15}/> Add a knowledge source</button></div><div className="rail-tip"><Sparkles size={17}/><div><b>Make knowledge useful</b><p>Upload a report, handbook or project brief, then ask a specific question.</p></div></div></aside>
    <input ref={fileRef} type="file" accept=".pdf,.docx,.txt,.md,.csv,.json" hidden onChange={e => void uploadFile(e.target.files?.[0])}/>
    {notice && <div className="toast"><span>{notice}</span><button onClick={() => setNotice('')} aria-label="Dismiss"><X size={15}/></button></div>}
  </main>;
}



